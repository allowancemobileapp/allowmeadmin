# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Firebase (web config)
# ---------------------------------------------------------------------------
# These are PUBLIC by design. A Firebase web config identifies the project; it
# does not authorise anything. What protects the API is the signed ID token the
# browser gets after signing in, verified server-side on every request.
VITE_FIREBASE_API_KEY=AIzaSyDxfd9hJ0NYN9KNP6UdCTU5VWHGLum-VFE
VITE_FIREBASE_AUTH_DOMAIN=allowance-001.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=allowance-001
VITE_FIREBASE_STORAGE_BUCKET=allowance-001.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=463313212619
VITE_FIREBASE_APP_ID=1:463313212619:web:29b6ae18f4648e6ae1774e
VITE_FIREBASE_MEASUREMENT_ID=G-1K8Q2V9G2Y

# Which project's tokens the SERVER will accept. Defaults to allowance-001.
# It must match the project the browser signs in to, or every request is
# refused as "issued for a different application" -- that check is the only
# thing stopping a token from somebody else's Firebase project being accepted.
FIREBASE_PROJECT_ID=allowance-001

# ---------------------------------------------------------------------------
# Supabase storage  (REQUIRED -- uploads fail without these)
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY IS A MASTER KEY. It bypasses every row-level
# security policy in the project: whoever holds it can read and write every
# table. It belongs here and in Vercel's environment variables, and NOWHERE
# else -- never in source, never in anything the browser downloads.
#
# The key that used to be hardcoded in src/pages/Library.tsx shipped inside
# the client bundle to every visitor. Treat it as compromised: rotate it in
# Supabase (Settings -> API -> service_role -> regenerate) before deploying,
# because deleting it from the code does not un-publish what was already
# served.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Server-side only. Never expose as VITE_*, or it ships to the browser.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# CORS (optional)
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call the API, on top of localhost and
# *.vercel.app which are always permitted. Only needed if the admin app is
# served from a custom domain.
# ALLOWED_ORIGINS=https://admin.yourdomain.com
