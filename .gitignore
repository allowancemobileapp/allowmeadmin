# server.js IS COMMITTED ON PURPOSE. Do not add it back to this file.
#
# package.json sets "type": "module", and api/index.ts does
#   import app from "../server.js"
# Node ESM does not resolve .js to .ts, so that import needs a real server.js
# on disk. Deleting it takes the whole API down with
# FUNCTION_INVOCATION_FAILED.
#
# It went stale once and cost months: every route added after it was last
# built -- finance, school management, feed approvals -- 404'd in production
# while working on localhost. `npm run build` and `vercel-build` now both
# regenerate it, so it tracks server.ts automatically.
